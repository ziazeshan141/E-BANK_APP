FROM node:14-bullseye

WORKDIR /app

# Install build dependencies for old native modules such as bcrypt
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./

RUN npm install --omit=dev

COPY backend ./backend
COPY server.js ./

EXPOSE 3000

CMD ["node", "server.js"]