# ============================================================

# E-BANK Angular Frontend - Production Dockerfile

# ============================================================

# ------------------------------------------------------------

# Stage 1: Build Angular application

# ------------------------------------------------------------

FROM node:14-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci --ignore-scripts

COPY . .

RUN npm run build -- --configuration=production

# ------------------------------------------------------------

# Stage 2: Production Nginx

# ------------------------------------------------------------

FROM nginx:1.27-alpine

# Upgrade Alpine packages to patched versions

RUN apk update && apk upgrade --no-cache

# Remove default Nginx configuration

RUN rm -f /etc/nginx/conf.d/default.conf

# Configure Nginx

RUN sed -i 's#pid        /run/nginx.pid;#pid /run/nginx/nginx.pid;#' /etc/nginx/nginx.conf && mkdir -p /run/nginx

# Copy Nginx configuration

COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy Angular build from builder stage

COPY --from=builder /app/dist/mean-course /usr/share/nginx/html

# Set permissions

RUN chown -R nginx:nginx /run/nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d

EXPOSE 8080

USER nginx

CMD ["nginx", "-g", "daemon off;"]
